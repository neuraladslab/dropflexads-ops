{
  "name": "dropflexads-ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test src/domain/domain.test.ts src/lib/dropi/parse/parse.test.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "auth:init": "node scripts/auth-init.mjs",
    "auth:secret": "node scripts/auth-init.mjs --print",
    "user:create": "node --env-file=.env.local scripts/user-create.mjs",
    "user:passwd": "node --env-file=.env.local scripts/user-passwd.mjs",
    "user:disable": "node --env-file=.env.local scripts/user-disable.mjs",
    "auth:revoke-all": "node --env-file=.env.local scripts/auth-revoke-all.mjs",
    "auth:unlock": "node --env-file=.env.local scripts/auth-unlock.mjs",
    "auth:2fa-reset": "node --env-file=.env.local scripts/auth-2fa-reset.mjs",
    "security:audit": "npm audit --omit=dev",
    "security:smoke": "node --env-file=.env.local scripts/security-smoke.mjs",
    "captura": "node scripts/captura.mjs",
    "lint:undef": "eslint --rule '{\"no-undef\":\"error\"}' src/lib src/app/api scripts",
    "verificar": "tsc --noEmit && npm run lint:undef && npm test"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "next": "16.4.0",
    "postgres": "^3.4.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright": "^1.64.0",
    "typescript": "^5"
  },
  "type": "module"
}
